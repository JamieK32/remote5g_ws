					<namespace>/camera/gimbal</namespace>
					<remapping>gimbal/image_raw:=image_raw</remapping>
					<remapping>gimbal/camera_info:=camera_info</remapping>
				</ros>
				<camera_name>gimbal</camera_name>
				<frame_name>gimbal_camera_optical_frame</frame_name>
			</plugin>
		</sensor>
	</gazebo>
